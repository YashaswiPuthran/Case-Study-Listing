# Ignore directories generated by Composer.
/vendor/

# Ignore Drupal core, contrib, and their scaffolded files.
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/sites/*/settings.local.php
/web/sites/*/files/
/web/sites/simpletest/
/web/.htaccess
/web/autoload.php
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/INSTALL.txt
/web/README.md

# Ignore common local/editor artifacts.
.env
*.log
.DS_Store
